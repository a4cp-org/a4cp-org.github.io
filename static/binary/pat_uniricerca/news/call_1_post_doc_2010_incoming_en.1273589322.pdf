rrer"> <svg class="icon icon-sm align-top" role="presentation" focusable="false"><use xlink:href="/extension/openpa_bootstrapitalia/design/bootstrapitalia2110/images/svg/sprites.svg#it-youtube"></use></svg> <span class="visually-hidden">YouTube</span> </a> </li> <li> <a href="https://www.ufficiostampa.provincia.tn.it/Modulo-WhatsPAT" target="_blank" rel="noopener noreferrer"> <svg class="icon icon-sm align-top" role="presentation" focusable="false"><use xlink:href="/extension/openpa_bootstrapitalia/design/bootstrapitalia2110/images/svg/sprites.svg#it-whatsapp"></use></svg> <span class="visually-hidden">Whatsapp</span> </a> </li> </ul><ul> <li> <a href="https://t.me/Provincia_autonoma_di_Trento" target="_blank" rel="noopener noreferrer"> <svg class="icon icon-sm align-top" role="presentation" focusable="false"><use xlink:href="/extension/openpa_bootstrapitalia/design/bootstrapitalia2110/images/svg/sprites.svg#it-telegram"></use></svg> <span class="visually-hidden">Telegram</span> </a> </li> </ul></div> </div> </div> </nav> </div> </div> </div></div><script>$(document).ready(function() {
